# Keep the password in sync with DB_PASSWORD (used by the postgres container).
DB_PASSWORD=curiox
DATABASE_URL=postgresql+asyncpg://curiox:curiox@postgres:5432/curiox
REDIS_URL=redis://redis:6379/0
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# name:token pairs, comma separated. Use long random tokens.
DASHBOARD_USERS=admin:change-me
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
IG_API_VERSION=v26.0
IG_APP_SECRET=
IG_WEBHOOK_VERIFY_TOKEN=
RELEVANCE_THRESHOLD=0.65
RELEVANCE_WEIGHTS={"topic":0.30,"audience":0.25,"conversation":0.20,"quality":0.15,"recency":0.10}
# Safety flags: the app refuses to start if these are changed.
HUMAN_APPROVAL_REQUIRED=true
THIRD_PARTY_AUTO_COMMENT=false
DISCOVERY_MODE=approved_sources
TIMEZONE=Asia/Kolkata
